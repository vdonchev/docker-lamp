#========================================================================#
# PHP Configuration
#
# Specify which PHP version to use. This will determine the image used for
# the web server container.
#
# Available image directories:
#   php56, php70, php71, php72, php73, php74,
#   php80, php81, php82, php83, php84, php85
# PHP 8.2-8.5 are supported upstream; older branches are retained only for
# legacy project compatibility.
#========================================================================#
PHP_VERSION=php85

#========================================================================#
# PHP Image Tag (Optional)
#
# Optionally specify a PHP image tag (including patch level)
# to use for the Apache container. If set, this will override the default
# base image tag derived from PHP_VERSION (e.g. php:8.4-apache).
#
# Docker tags can be republished, so patch tags improve consistency but are
# not immutable.
# Example values:
#   8.5.11, 8.4.26, 7.4.33
#
# If not set, the base image will fallback to the major.minor version from
# PHP_VERSION (e.g. php:8.4-apache).
#========================================================================#
PHP_IMAGE_TAG=

#========================================================================#
# WP-CLI Configuration
#
# WP_CLI_VERSION - Optional WP-CLI release installed in PHP 8+ images.
#                   Leave empty to install the latest stable release.
#                   Example: WP_CLI_VERSION=2.12.0
#========================================================================#
WP_CLI_VERSION=

#========================================================================#
# Xdebug Configuration
#
# ENABLE_XDEBUG    - Controls whether Xdebug is activated at container startup.
#                    true  = entrypoint enables Xdebug for debugging
#                    false = Xdebug remains installed but inactive
#========================================================================#
ENABLE_XDEBUG=false

#========================================================================#
# Node Configuration
#
# NODE_VERSION - Docker image tag for the optional Node container.
#                Default uses Node 24.
#                Legacy projects can override this, e.g. 14.21.3.
#========================================================================#
NODE_VERSION=24

#========================================================================#
# SQL Configuration
#
# Choose which SQL engine to use: "mysql" or "mariadb".
#
# SQL_ENGINE       - Database engine type (mysql | mariadb)
# SQL_VERSION      - Image version tag (e.g. 8.4, 8.4.10, 12.3)
#
# Supported examples:
#   SQL_ENGINE=mysql   SQL_VERSION=8.4     -> uses image mysql:8.4
#   SQL_ENGINE=mariadb SQL_VERSION=12.3    -> uses image mariadb:12.3
#
# SQL_PORT         - Port on which the database will be accessible on the host
# SQL_ROOT_PWD     - Root password for the database
# SQL_DATA_PATH    - Base directory on the host to persist database data.
#                    Each engine/major.minor combination gets its own subfolder.
#                    Example: /var/db/mysql84 or /var/db/mariadb123
#========================================================================#
SQL_ENGINE=mysql
SQL_VERSION=8.4
SQL_PORT=3306
SQL_ROOT_PWD=root
SQL_DATA_PATH=/home/your-user/db-data

#========================================================================#
# Web Root Configuration
#
# WEB_ROOT         - Path to your project's source code on the host machine.
#                    This will be mounted to the web container's document root.
#
# HTTP_PORT        - Port on the host for HTTP
# HTTPS_PORT       - Port on the host for HTTPS
#========================================================================#
WEB_ROOT=/home/your-user/projects/my-app
HTTP_PORT=80
HTTPS_PORT=443

#========================================================================#
# phpMyAdmin Configuration
#
# PMA_VERSION      - Optional phpMyAdmin Docker image tag; empty uses latest
#                    Example: PMA_VERSION=5.2.3
# PMA_PORT         - Port on the host to access phpMyAdmin
#========================================================================#
PMA_VERSION=
PMA_PORT=8080

#========================================================================#
# Optional Service Versions
# Leave empty to use the latest Redis and Mailpit images.
# Examples: REDIS_VERSION=8.10, MAILPIT_VERSION=v1.31.3
#========================================================================#
REDIS_VERSION=
MAILPIT_VERSION=

#========================================================================#
# Git Identity Configuration
#
# Define a default Git username and email for commits created inside the
# web container when using PHP 7+. These credentials are applied during image build
# so that tools like the Symfony CLI can initialize new projects without
# prompting for user identity.
#
# Notes:
#   - These values are local only and have no effect outside the container.
#   - Leave them empty to skip Git configuration.
#   - Example:
#       GIT_USER_NAME=Local Dev
#       GIT_USER_EMAIL=dev@localhost
#========================================================================#
GIT_USER_NAME=
GIT_USER_EMAIL=
